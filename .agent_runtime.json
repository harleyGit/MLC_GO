{
  "$schema": "https://your-org.ai/agent-runtime.schema.json",
  "version": "1.0",
  "active_model": "glm",

  "strategy": {
    "merge_common_rules": true,
    "prefer_strict_mode": true,
    "conflict_policy": "conservative"
  },

  "shared_rules": {
    "base": [
      "AGENTS.md",
      ".ai_agents/00-core.md",
      ".ai_agents/01-style.md"
    ],
    "validation": [
      ".ai_agents/05-validation.md",
      ".ai_agents/06-output.md",
      ".ai_agents/07-forbidden.md",
      ".ai_agents/08-performance.md"
    ],
    "go": [".ai_agents/02-go-rules.md"],
    "api": [".ai_agents/03-api-rules.md"],
    "data": [".ai_agents/04-data-rules.md"]
  },

  "models": {
    "codex": {
      "description": "OpenAI Codex / GPT-4 based agents",
      "extends": "shared_rules",
      "overrides": {}
    },
    "glm": {
      "description": "GLM (智谱) model",
      "extends": "shared_rules",
      "overrides": {}
    },
    "claude": {
      "description": "Anthropic Claude model",
      "extends": "shared_rules",
      "overrides": {}
    }
  },

  "task_mapping": {
    "go": ["go", "service", "handler"],
    "api": ["api", "controller"],
    "data": ["repository", "dao", "db", "sql"],
    "performance": ["optimize", "benchmark"],
    "validation": ["validate", "check"]
  }
}
