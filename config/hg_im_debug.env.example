# 仅供本机隔离 debug 参考；本文件不会被自动加载。
# 将下面的键按需写入不提交 Git 的 config/MLC.local.env 或由进程环境注入。
# 所有凭据都必须使用不同的随机值，绝不将真实密钥提交到仓库。
# 缺失外部服务时保持默认关闭；不要用这些空值开启 IM 扩展。
MLC_IM_REALTIME_ENABLED=false
MLC_IM_MEDIA_ENABLED=false
MLC_IM_CALL_ENABLED=false
MLC_IM_TOPIC=mlc.im.messages.v1
MLC_IM_CONSUMER_GROUP=mlc-debug-im-v1
MLC_IM_CENTRIFUGO_API_URL=
MLC_IM_CENTRIFUGO_WS_URL=
MLC_IM_CENTRIFUGO_API_KEY=
MLC_IM_CENTRIFUGO_TOKEN_SECRET=

# Go 服务需要隔离区上传与封存区读取权限；审核进程使用另一套访问身份。
MLC_IM_S3_ENDPOINT=
MLC_IM_S3_REGION=
MLC_IM_S3_BUCKET=
MLC_IM_S3_ACCESS_KEY=
MLC_IM_S3_SECRET_KEY=

# 与独立审核进程共享此随机 Bearer Token，至少 32 字符；只允许 loopback HTTP 或受控 TLS。
MLC_IM_REVIEW_URL=http://127.0.0.1:8092/review
MLC_IM_REVIEW_TOKEN=
MLC_IM_REVIEW_LISTEN=127.0.0.1:8092
MLC_IM_REVIEW_CLAMD_ADDR=127.0.0.1:3310
MLC_IM_REVIEW_FFPROBE=
MLC_IM_REVIEW_FFMPEG=
# 使用安装 deployments/im/hg_moderator_requirements.txt 的隔离 Python；模型只覆盖裸露内容。
MLC_IM_REVIEW_PYTHON=
MLC_IM_REVIEW_MODERATOR=
MLC_IM_REVIEW_TEMP_DIR=
MLC_IM_REVIEW_S3_ACCESS_KEY=
MLC_IM_REVIEW_S3_SECRET_KEY=
