{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // 由同名联合调试入口启动；依赖检查在 compound 中先执行，避免 crawler 抢先连接尚未就绪的依赖。
      "name": "MLC_GO Debug（主服务进程）", // 配置名称
      "presentation": { "hidden": true },
      "type": "go", // 调试类型（Go）
      "request": "launch", // 启动模式（launch 或 attach）
      "mode": "auto", // 调试模式（auto/debug/test）
      "dlvFlags": ["--check-go-version=false"], // 当前 Go 版本高于 Delve 声明支持版本时，跳过 Delve 版本检查
      "buildFlags": "-tags=production",
      "program": "${workspaceFolder}", // 按 main 包整体启动，避免只编译 main.go 导致同包符号缺失
      "cwd": "${workspaceFolder}",
      "args": [
        "--version=true",
        "--port=8081",
        "--data-path=/data/nsq",
        "--log-level=debug",
        "--tcp-port=4150",
        "--verbose",
        "-gen"
      ], // 命令行参数
      "env": {
        "GOPATH": "${env:GOPATH}",
        "MY_ENV": "debug",
        "SERVER_ENV": "debug",
        "MLC_CONFIG_DIR": "${workspaceFolder}/config",
        // 联合调试由独立 crawler 进程采集，避免主服务同时运行另一份 Bilibili worker。
        "CRAWLER_BILIBILI_ENABLED": "false",
        // 仅隔离 debug 显式开启；模拟充值会写真实平台币余额。
        "MLC_WALLET_DEBUG_PAYMENT_ENABLED": "true",
        "KAFKA_REQUIRED": "false"
      },
      "showLog": true, // 显示调试日志
      "console": "integratedTerminal" // 👈 关键：使用集成终端,解决在vscode中debug【调试控制台】无法输入，使其【调试控制台】与终端大致合并
      //"stopOnEntry": true //“启动调试”按钮后程序就立即暂停在入口（main函数），可以立即 Evaluate 表达式
    },
    {
      // 8080 主服务已运行时可单独选择此项；无 --help，直接启动 8090 管理 API 和周期 worker。
      "name": "🕷️ Launch hg_crawler Debug",
      "presentation": { "group": "MLC", "order": 2 },
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${workspaceFolder}/cmd/hg_crawler",
      "cwd": "${workspaceFolder}",
      "output": "${env:TMPDIR}/hg-crawler-debug",
      "env": {
        "SERVER_ENV": "debug",
        "MLC_CONFIG_DIR": "${workspaceFolder}/config"
      },
      "args": [
        "--addr=:8090",
        "--env=debug",
        "--config-dir=${workspaceFolder}/config"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "💥 Launch MLC_GO Pre",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "dlvFlags": ["--check-go-version=false"],
      "preLaunchTask": "ensure-pre-deps",
      "program": "${workspaceFolder}",
      "args": [
        "--version=true",
        "--port=8081",
        "--data-path=/data/nsq",
        "--log-level=debug",
        "--tcp-port=4150",
        "--verbose",
        "-gen"
      ],
      "env": {
        "GOPATH": "${env:GOPATH}",
        "MY_ENV": "pre",
        "SERVER_ENV": "pre",
        "KAFKA_REQUIRED": "true"
      },
      "showLog": true,
      "console": "integratedTerminal"
    },
    {
      "name": "🎾 Launch MLC_GO Prod",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "dlvFlags": ["--check-go-version=false"],
      "preLaunchTask": "ensure-prod-deps",
      "program": "${workspaceFolder}",
      "args": [
        "--version=true",
        "--port=8081",
        "--data-path=/data/nsq",
        "--log-level=debug",
        "--tcp-port=4150",
        "--verbose",
        "-gen"
      ],
      "env": {
        "GOPATH": "${env:GOPATH}",
        "MY_ENV": "prod",
        "SERVER_ENV": "prod",
        "KAFKA_REQUIRED": "true"
      },
      "showLog": true,
      "console": "integratedTerminal"
    },
    {
      // 打开 cmd/<入口>/main.go 后选择此项，以整个包启动，配置路径始终相对工程根目录。
      "name": "🛠️ Launch cmd（当前入口）",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${fileDirname}",
      "cwd": "${workspaceFolder}",
      "env": {
        "SERVER_ENV": "debug",
        "MLC_CONFIG_DIR": "${workspaceFolder}/config"
      },
      // 默认查看入口参数；执行具体任务时按该入口的 --help 修改 args。
      "args": ["--help"],
      "console": "integratedTerminal"
    },
    {
      // 运行和调试面板可直接选择 cmd 入口，不依赖当前打开的文件。
      "name": "🛠️ Launch cmd（选择入口）",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${workspaceFolder}/cmd/${input:hgCmdEntry}",
      "cwd": "${workspaceFolder}",
      "env": {
        "SERVER_ENV": "debug",
        "MLC_CONFIG_DIR": "${workspaceFolder}/config"
      },
      "args": ["--help"],
      "console": "integratedTerminal"
    },
    {
      //针对包的调试配置
      "name": "Launch Package",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${fileDirname}" //调试当前文件所在的包
    },
    {
      //测试调试配置
      "name": "Debug test",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${workspaceFolder}",
      "args": ["-test.run", "MyTestFunction"]
    },
    {
      //带参数的调试
      "name": "Launch with args",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${workspaceFolder}", //调试工作区根目录（适用于有 main 包的项目）
      "args": ["--port=8080", "--env=dev"]
    },
    {
      // 当前目录包调试（不要用单文件模式，避免 main.go 引用其他文件时报 undefined）
      "name": "Launch current package",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${fileDirname}" //调试当前打开文件所在目录对应的包
    },
    {
      //基本调试配置（适用于单个文件）
      "name": "Launch current file",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${file}" //调试当前打开的文件
    },
    {
      "name": "⚡️ 性能分析 Run performance_practice",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "dlvFlags": ["--check-go-version=false"],
      "program": "${workspaceFolder}/TestNotes/performance_practice/performance_analysis_main.go",
      "args": []
    }
  ],
  "compounds": [
    {
      // 保留原 Debug 入口名称；先完成依赖检查，再同时启动业务 API 和前端代理需要的 crawler API。
      "name": "🧪 Launch MLC_GO Debug",
      "presentation": { "group": "MLC", "order": 1 },
      "configurations": [
        "MLC_GO Debug（主服务进程）",
        "🕷️ Launch hg_crawler Debug"
      ],
      "preLaunchTask": "ensure-debug-deps",
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "hgCmdEntry",
      "type": "pickString",
      "description": "选择 cmd 下可运行的 main 包（cmd/server 暂无 main 函数）",
      "options": [
        "hg_recharge_migrate",
        "hg_config_check",
        "hg_crawler",
        "hg_video_comment_reaction_backfill"
      ],
      "default": "hg_recharge_migrate"
    }
  ]
}
