{
  // VS Code 在调试前会先执行这里定义的任务。
  "version": "2.0.0",
  "tasks": [
    {
      // launch.json 里通过 preLaunchTask 引用的任务名。
      "label": "ensure-debug-deps",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ensure_debug_deps.sh",
      "args": ["debug"],
      "options": {
        // 固定在项目根目录执行，避免路径解析差异。
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        // 始终展示终端，确保能看到 MySQL/Redis 检查及启动提示。
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      // 不需要从输出里提取编译错误，因此不配置 problemMatcher。
      "problemMatcher": []
    },
    {
      // 按顺序准备基础设施，再复用或启动 debug 独立服务；刷新主服务不会重启它们。
      "label": "ensure-debug-services",
      "dependsOn": ["ensure-debug-deps", "ensure-debug-aux"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "ensure-debug-aux",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ensure_debug_aux.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "ensure-pre-deps",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ensure_debug_deps.sh pre",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "ensure-prod-deps",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/ensure_debug_deps.sh prod",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
