{
  "client": {
    "allowed_origins": ["http://localhost:5173", "http://localhost:5174"],
    "token": {
      "issuer": "mlc-im",
      "audience": "centrifugo"
    }
  },
  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis://127.0.0.1:6379"
    }
  },
  "rpc": {
    "proxy": {
      "endpoint": "http://127.0.0.1:9091/internal/im/centrifugo/rpc",
      "timeout": "8s"
    },
    "namespaces": [
      { "name": "im", "proxy_enabled": true }
    ]
  },
  "channel": {
    "namespaces": [
      {
        "name": "im",
        "allow_subscribe_for_client": false,
        "allow_subscribe_for_anonymous": false,
        "allow_publish_for_client": false,
        "allow_publish_for_subscriber": false,
        "history_size": 100,
        "history_ttl": "300s",
        "force_recovery": true
      }
    ]
  }
}
